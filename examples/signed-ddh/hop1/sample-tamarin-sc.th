(fst(fst(yB)) = pk(sample_key(rkB)) &&
  verify(pair(pair(expo(g, sample_exp(ra)), snd(fst(yB))), pk(sample_key(rkA))), snd(yB), pk(sample_key(rkB))) = ok &&
