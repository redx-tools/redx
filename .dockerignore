# Generated example outputs: regenerated by every run and mounted over
# at runtime, so they only bloat the build context and invalidate the
# COPY layer on each invocation.
examples/**/proverif-*
examples/**/tamarin-*
examples/**/tamarin-unchained-*
examples/report.txt

# Internal trees not needed in the image.
examples-wip/
scratch/
.old/
.vscode/
report.txt

# Host build trees: the image builds its own.
# (vendors/*/out/ is deliberately NOT excluded: excluding it would change
# the content of stage 1's COPY layers and force a full Tamarin rebuild.)
_build/
build/
